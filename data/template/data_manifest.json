{
  "schema_version": "pharma_rd_template_v0.1",
  "purpose": "多领域医药研发决策数据模板",
  "status": "template_only",
  "default_domain_scope": "待配置",
  "id_rules": {
    "domain": "DOM_<slug>",
    "organization": "ORG_<slug>",
    "asset": "ASSET_<slug>",
    "indication": "IND_<slug>",
    "study": "STUDY_<identifier_or_slug>",
    "publication": "PUB_<slug>",
    "regulatory_event": "REG_<slug>",
    "market_event": "MKT_<slug>",
    "source": "SRC_<slug>",
    "fact": "FACT_<slug>",
    "relation": "REL_<slug>"
  },
  "entity_types": [
    "domain",
    "organization",
    "asset",
    "indication",
    "study",
    "publication",
    "regulatory_event",
    "market_event",
    "source",
    "fact"
  ],
  "relation_statuses": ["confirmed", "probable", "unresolved", "rejected"],
  "verification_statuses": ["verified", "partially_verified", "pending", "invalid"],
  "files": [
    "domains.csv",
    "organizations.csv",
    "organization_aliases.csv",
    "assets.csv",
    "asset_aliases.csv",
    "indications.csv",
    "studies.csv",
    "study_identifiers.csv",
    "publications.csv",
    "regulatory_events.csv",
    "market_events.csv",
    "sources.csv",
    "facts.csv",
    "relations.csv"
  ]
}
